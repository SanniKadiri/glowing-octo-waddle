# Generate two distinct values with openssl rand -hex 32.
ACTION_REVIEW_KEY=
POSTGRES_PASSWORD=

# Node server defaults to SQLite on loopback. To use managed PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# PG_CA_FILE=/absolute/path/to/provider-ca.pem
# HOST=127.0.0.1
# PORT=8787
# SQLITE_PATH=data/action-review.sqlite
